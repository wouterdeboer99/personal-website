---
import Layout from '../layouts/Layout.astro';
import { t, localizedPath, type Lang } from '../i18n/index';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const i = t(lang);
const p = i.portfolio;
---

<Layout title={i.nav.portfolio} lang={lang}>

  <section class="page-hero" aria-labelledby="portfolio-title">
    <div class="container">
      <span class="label">{p.hero.label}</span>
      <h1 class="page-hero-title" id="portfolio-title">
        {p.hero.title} <span class="gradient-text">{p.hero.titleAccent}</span>
      </h1>
      <p class="page-hero-sub">{p.hero.sub}</p>
      <p class="page-hero-note">{p.hero.note}</p>
    </div>
  </section>

  <section class="section" aria-label="Portfolio projects">
    <div class="container projects-grid">
      {p.items.map(proj => (
        <article class="project-card glass-card" aria-label={proj.title}>
          <header class="project-header">
            <span class="project-category label" style="margin-bottom:0;">{proj.category}</span>
          </header>
          <h2 class="project-title">{proj.title}</h2>
          <p class="project-client">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
            {proj.client}
          </p>
          <p class="project-desc">{proj.desc}</p>
          <ul class="project-outcomes" aria-label="Key outcomes">
            {proj.outcomes.map(o => (
              <li>
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="7" stroke="rgba(16,185,129,0.3)" stroke-width="1"/>
                  <polyline points="5,8 7,10 11,6" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {o}
              </li>
            ))}
          </ul>
          <div class="project-tags">
            {proj.tags.map(tag => <span class="tag">{tag}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" style="text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:600px;height:300px;background:radial-gradient(ellipse,rgba(0,200,255,0.08) 0%,transparent 70%);pointer-events:none;" aria-hidden="true"></div>
    <div class="container" style="position:relative;z-index:1;">
      <h2 class="section-title">
        {p.cta.title} <span class="gradient-text">{p.cta.titleAccent}</span>
      </h2>
      <p class="section-subtitle" style="margin:0 auto 2.5rem;max-width:500px;">{p.cta.sub}</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href={localizedPath('/contact', lang)} class="btn btn-primary">{p.cta.cta1}</a>
        <a href={localizedPath('/services', lang)} class="btn btn-outline">{p.cta.cta2}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero-note { margin-top:1rem; font-size:0.8rem; color:var(--text-muted); }
  .projects-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; }
  .project-card { padding:2rem; display:flex; flex-direction:column; gap:1rem; }
  .project-header { display:flex; justify-content:space-between; align-items:center; }
  .project-category { font-size:0.7rem; }
  .project-title { font-size:1.2rem; font-family:var(--font-heading); font-weight:600; line-height:1.3; }
  .project-client { display:flex; align-items:center; gap:0.5rem; font-size:0.82rem; color:var(--text-muted); }
  .project-desc { font-size:0.875rem; color:var(--text-secondary); line-height:1.75; flex:1; }
  .project-outcomes { list-style:none; display:flex; flex-direction:column; gap:0.5rem; padding:1rem; background:rgba(16,185,129,0.04); border:1px solid rgba(16,185,129,0.12); border-radius:10px; }
  .project-outcomes li { display:flex; align-items:center; gap:0.625rem; font-size:0.82rem; color:var(--text-secondary); }
  .project-tags { display:flex; flex-wrap:wrap; gap:0.4rem; }
  .tag { font-size:0.72rem; color:var(--text-secondary); background:rgba(255,255,255,0.04); border:1px solid var(--border); padding:0.25rem 0.625rem; border-radius:100px; }
  @media (max-width:768px) { .projects-grid { grid-template-columns:1fr; } }
</style>
