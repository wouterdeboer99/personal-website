---
import Layout from '../layouts/Layout.astro';
import { t, localizedPath, type Lang } from '../i18n/index';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const i = t(lang);
const p = i.portfolio;

const cardStyles = [
  {
    gradient: 'linear-gradient(135deg,#1B3A5C 0%,#2A5A8C 100%)',
    icon: `<svg width="38" height="38" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.25" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><circle cx="4" cy="6" r="2"/><circle cx="20" cy="6" r="2"/><circle cx="4" cy="18" r="2"/><circle cx="20" cy="18" r="2"/><path d="M6 6h4M14 6h4M6 18h4M14 18h4M10 12H6M18 12h-4"/></svg>`,
  },
  {
    gradient: 'linear-gradient(135deg,#2A5A8C 0%,#4A8ABE 100%)',
    icon: `<svg width="38" height="38" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.25" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
  },
  {
    gradient: 'linear-gradient(135deg,#1B4D6E 0%,#1B6CA8 100%)',
    icon: `<svg width="38" height="38" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.25" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="4" rx="1"/><rect x="2" y="10" width="20" height="4" rx="1"/><rect x="2" y="17" width="20" height="4" rx="1"/></svg>`,
  },
  {
    gradient: 'linear-gradient(135deg,#243B55 0%,#2A5A8C 100%)',
    icon: `<svg width="38" height="38" fill="none" stroke="rgba(255,255,255,0.45)" stroke-width="1.25" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  },
];
---

<Layout title={i.nav.portfolio} lang={lang}>

  <section class="page-hero" aria-labelledby="portfolio-title">
    <div class="container">
      <span class="label">{p.hero.label}</span>
      <h1 class="page-hero-title" id="portfolio-title">
        {p.hero.title} <span class="gradient-text">{p.hero.titleAccent}</span>
      </h1>
      <p class="page-hero-sub">{p.hero.sub}</p>
      <p class="page-hero-note">{p.hero.note}</p>
    </div>
  </section>

  <section class="section" aria-label="Portfolio projects">
    <div class="container projects-grid">
      {p.items.map((proj, idx) => (
        <article class="project-card glass-card" aria-label={proj.title}>
          <div class="project-band" style={`background:${cardStyles[idx].gradient}`}>
            <div>
              <div class="project-band-category">{proj.category}</div>
              <div class="project-band-title">{proj.title}</div>
            </div>
            <div class="project-band-icon" set:html={cardStyles[idx].icon} aria-hidden="true" />
          </div>
          <div class="project-body">
            <p class="project-client">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
              {proj.client}
            </p>
            <p class="project-desc">{proj.desc}</p>
            <ul class="project-outcomes" aria-label="Key outcomes">
              {proj.outcomes.map(o => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <circle cx="8" cy="8" r="7" stroke="rgba(16,185,129,0.3)" stroke-width="1"/>
                    <polyline points="5,8 7,10 11,6" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  {o}
                </li>
              ))}
            </ul>
            <div class="project-tags">
              {proj.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" style="text-align:center;background:var(--bg-surface);">
    <div class="container" style="position:relative;z-index:1;">
      <h2 class="section-title">
        {p.cta.title} <span class="gradient-text">{p.cta.titleAccent}</span>
      </h2>
      <p class="section-subtitle" style="margin:0 auto 2.5rem;max-width:500px;">{p.cta.sub}</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href={localizedPath('/contact', lang)} class="btn btn-primary">{p.cta.cta1}</a>
        <a href={localizedPath('/services', lang)} class="btn btn-outline">{p.cta.cta2}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero-note { margin-top:1rem; font-size:0.8rem; color:var(--text-muted); }
  .projects-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; }
  .project-card { padding:0; display:flex; flex-direction:column; overflow:hidden; }
  .project-band { display:flex; align-items:center; justify-content:space-between; padding:1.25rem 1.5rem; min-height:88px; gap:1rem; }
  .project-band-category { font-size:0.6rem; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:rgba(255,255,255,0.65); margin-bottom:0.3rem; }
  .project-band-title { font-size:0.95rem; font-weight:600; color:#fff; font-family:var(--font-heading); line-height:1.25; }
  .project-band-icon { flex-shrink:0; }
  .project-body { padding:1.5rem; display:flex; flex-direction:column; gap:1rem; flex:1; }
  .project-client { display:flex; align-items:center; gap:0.5rem; font-size:0.8rem; color:var(--text-muted); }
  .project-desc { font-size:0.875rem; color:var(--text-secondary); line-height:1.75; flex:1; }
  .project-outcomes { list-style:none; display:flex; flex-direction:column; gap:0.5rem; padding:1rem; background:rgba(5,150,105,0.04); border:1px solid rgba(5,150,105,0.12); border-radius:10px; }
  .project-outcomes li { display:flex; align-items:center; gap:0.625rem; font-size:0.82rem; color:var(--text-secondary); font-weight:500; }
  .project-tags { display:flex; flex-wrap:wrap; gap:0.4rem; }
  .tag { font-size:0.72rem; color:var(--text-secondary); background:var(--bg-surface); border:1px solid var(--border); padding:0.25rem 0.625rem; border-radius:100px; }
  @media (max-width:768px) { .projects-grid { grid-template-columns:1fr; } }
</style>
