---
import Layout from '../layouts/Layout.astro';
import { t, localizedPath, type Lang } from '../i18n/index';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const i = t(lang);
const h = i.home;

const serviceIcons = [
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v6c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 11v6c0 1.66 4.03 3 9 3s9-1.34 9-3v-6"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><circle cx="4" cy="6" r="2"/><circle cx="20" cy="6" r="2"/><circle cx="4" cy="18" r="2"/><circle cx="20" cy="18" r="2"/><path d="M6 6h4M14 6h4M6 18h4M14 18h4M10 12H6M18 12h-4"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
  `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M17.5 17.5L21 21M14 17.5h3.5v3.5"/></svg>`,
];
---

<Layout title={i.nav.home} lang={lang}>

  <!-- HERO -->
  <section class="hero" aria-label="Introduction">
    <div class="hero-bg" aria-hidden="true">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="available-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          {h.hero.badge}
        </span>
        <h1 class="hero-title">
          {h.hero.title}<br /><span class="gradient-text">{h.hero.titleAccent}</span>
        </h1>
        <p class="hero-sub">
          {h.hero.intro} <strong>{h.hero.name}</strong> {h.hero.sub}
        </p>
        <div class="hero-actions">
          <a href={localizedPath('/services', lang)} class="btn btn-primary">{h.hero.cta1}</a>
          <a href={localizedPath('/portfolio', lang)} class="btn btn-outline">{h.hero.cta2}</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <svg class="data-network" viewBox="0 0 420 360" fill="none">
          <line x1="210" y1="60"  x2="90"  y2="150" stroke="url(#eg)" stroke-width="1" opacity="0.4"/>
          <line x1="210" y1="60"  x2="330" y2="150" stroke="url(#eg)" stroke-width="1" opacity="0.4"/>
          <line x1="90"  y1="150" x2="60"  y2="270" stroke="url(#eg)" stroke-width="1" opacity="0.4"/>
          <line x1="90"  y1="150" x2="210" y2="240" stroke="url(#eg)" stroke-width="1" opacity="0.4"/>
          <line x1="330" y1="150" x2="360" y2="270" stroke="url(#eg)" stroke-width="1" opacity="0.4"/>
          <line x1="330" y1="150" x2="210" y2="240" stroke="url(#eg)" stroke-width="1" opacity="0.4"/>
          <line x1="210" y1="240" x2="150" y2="330" stroke="url(#eg)" stroke-width="1" opacity="0.3"/>
          <line x1="210" y1="240" x2="270" y2="330" stroke="url(#eg)" stroke-width="1" opacity="0.3"/>
          <line x1="60"  y1="270" x2="150" y2="330" stroke="url(#eg)" stroke-width="1" opacity="0.25"/>
          <line x1="360" y1="270" x2="270" y2="330" stroke="url(#eg)" stroke-width="1" opacity="0.25"/>
          <circle cx="210" cy="60"  r="14" fill="url(#ng)" opacity="0.9" class="node-pulse"/>
          <circle cx="210" cy="60"  r="22" fill="url(#ng)" opacity="0.12"/>
          <circle cx="90"  cy="150" r="10" fill="url(#ng)" opacity="0.75" class="node-pulse-2"/>
          <circle cx="90"  cy="150" r="18" fill="url(#ng)" opacity="0.1"/>
          <circle cx="330" cy="150" r="10" fill="url(#ng)" opacity="0.75"/>
          <circle cx="330" cy="150" r="18" fill="url(#ng)" opacity="0.1"/>
          <circle cx="60"  cy="270" r="7"  fill="url(#ng)" opacity="0.6"/>
          <circle cx="360" cy="270" r="7"  fill="url(#ng)" opacity="0.6"/>
          <circle cx="210" cy="240" r="12" fill="url(#ng)" opacity="0.8" class="node-pulse"/>
          <circle cx="210" cy="240" r="20" fill="url(#ng)" opacity="0.1"/>
          <circle cx="150" cy="330" r="6"  fill="url(#ng)" opacity="0.5"/>
          <circle cx="270" cy="330" r="6"  fill="url(#ng)" opacity="0.5"/>
          <defs>
            <linearGradient id="eg" x1="0" y1="0" x2="420" y2="360" gradientUnits="userSpaceOnUse">
              <stop offset="0%"   stop-color="#00C8FF"/>
              <stop offset="100%" stop-color="#6366F1"/>
            </linearGradient>
            <radialGradient id="ng" cx="50%" cy="50%" r="50%">
              <stop offset="0%"   stop-color="#00C8FF"/>
              <stop offset="100%" stop-color="#6366F1"/>
            </radialGradient>
          </defs>
        </svg>
      </div>
    </div>
    <div class="scroll-hint" aria-hidden="true"><span></span></div>
  </section>

  <!-- STATS -->
  <section class="stats-bar" aria-label="Key stats">
    <div class="container stats-grid">
      {h.stats.map(s => (
        <div class="stat">
          <span class="stat-value gradient-text">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section services" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-header">
        <span class="label">{h.services.label}</span>
        <h2 class="section-title" id="services-heading">
          {h.services.title} <span class="gradient-text">{h.services.titleAccent}</span>
        </h2>
        <p class="section-subtitle" style="max-width:560px;margin:0 auto;">{h.services.sub}</p>
      </div>
      <div class="services-grid">
        {h.services.items.map((s, idx) => (
          <a href={localizedPath('/services', lang)} class="service-card glass-card">
            <div class="service-icon" set:html={serviceIcons[idx]} />
            <h3 class="service-title">{s.title}</h3>
            <p class="service-desc">{s.desc}</p>
            <span class="service-link">{h.services.learnMore}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="section about-teaser" aria-labelledby="about-heading">
    <div class="container about-inner">
      <div class="about-text">
        <span class="label">{h.about.label}</span>
        <h2 class="section-title" id="about-heading">
          {h.about.title} <span class="gradient-text">{h.about.titleAccent}</span>
        </h2>
        <p class="section-subtitle" style="margin-bottom:1.25rem;">{h.about.para1}</p>
        <p class="section-subtitle" style="margin-bottom:2rem;">{h.about.para2}</p>
        <a href={localizedPath('/about', lang)} class="btn btn-primary">{h.about.cta}</a>
      </div>
      <div class="about-highlights">
        {h.about.highlights.map(hl => (
          <div class="highlight-card glass-card">
            <span class="highlight-icon" aria-hidden="true">{hl.icon}</span>
            <div>
              <h3 class="highlight-title">{hl.title}</h3>
              <p class="highlight-desc">{hl.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-section" aria-labelledby="cta-heading">
    <div class="cta-glow" aria-hidden="true"></div>
    <div class="container cta-inner">
      <h2 class="section-title" id="cta-heading">
        {h.cta.title} <span class="gradient-text">{h.cta.titleAccent}</span>
      </h2>
      <p class="section-subtitle" style="margin-bottom:2.5rem;">{h.cta.sub}</p>
      <div class="cta-actions">
        <a href={localizedPath('/contact', lang)} class="btn btn-primary">{h.cta.cta1}</a>
        <a href={localizedPath('/services', lang)} class="btn btn-outline">{h.cta.cta2}</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { min-height:100svh; display:flex; flex-direction:column; justify-content:center; position:relative; overflow:hidden; padding:6rem 0 4rem; }
  .hero-bg { position:absolute; inset:0; pointer-events:none; }
  .orb { position:absolute; border-radius:50%; filter:blur(80px); animation:float 8s ease-in-out infinite; }
  .orb-1 { width:500px; height:500px; top:-100px; right:-150px; background:radial-gradient(circle,rgba(99,102,241,0.18) 0%,transparent 70%); }
  .orb-2 { width:400px; height:400px; bottom:-100px; left:-100px; background:radial-gradient(circle,rgba(0,200,255,0.12) 0%,transparent 70%); animation-delay:-4s; }
  .hero-inner { display:grid; grid-template-columns:1fr 1fr; gap:4rem; align-items:center; position:relative; z-index:1; }
  .available-badge { display:inline-flex; align-items:center; gap:0.5rem; font-size:0.8rem; font-weight:500; color:var(--accent-tertiary); background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.25); padding:0.35rem 0.875rem; border-radius:100px; margin-bottom:1.75rem; }
  .badge-dot { width:7px; height:7px; border-radius:50%; background:var(--accent-tertiary); animation:pulse-glow 2s ease-in-out infinite; }
  .hero-title { font-size:clamp(2.5rem,6vw,4rem); letter-spacing:-0.03em; margin-bottom:1.5rem; line-height:1.1; }
  .hero-sub { font-size:1.05rem; color:var(--text-secondary); line-height:1.8; margin-bottom:2.5rem; max-width:480px; }
  .hero-sub strong { color:var(--text-primary); font-weight:600; }
  .hero-actions { display:flex; gap:1rem; flex-wrap:wrap; }
  .hero-visual { display:flex; justify-content:center; animation:float 7s ease-in-out infinite; }
  .data-network { width:100%; max-width:420px; filter:drop-shadow(0 0 30px rgba(0,200,255,0.15)); }
  .node-pulse { animation:pulse-glow 3s ease-in-out infinite; }
  .node-pulse-2 { animation:pulse-glow 3s ease-in-out infinite 1.5s; }
  .scroll-hint { position:absolute; bottom:2rem; left:50%; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; }
  .scroll-hint span { display:block; width:1.5px; height:48px; background:linear-gradient(to bottom,var(--accent-primary),transparent); animation:float 2s ease-in-out infinite; }
  .stats-bar { border-top:1px solid var(--border); border-bottom:1px solid var(--border); padding:2.5rem 0; background:rgba(13,27,62,0.3); }
  .stats-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:2rem; }
  .stat { display:flex; flex-direction:column; align-items:center; text-align:center; gap:0.35rem; }
  .stat-value { font-family:var(--font-heading); font-size:2.25rem; font-weight:700; letter-spacing:-0.03em; }
  .stat-label { font-size:0.85rem; color:var(--text-secondary); }
  .section-header { text-align:center; margin-bottom:3.5rem; }
  .services-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:1.25rem; }
  .service-card { padding:2rem; text-decoration:none; color:inherit; display:flex; flex-direction:column; gap:1rem; }
  .service-icon { width:52px; height:52px; display:flex; align-items:center; justify-content:center; background:rgba(0,200,255,0.08); border:1px solid rgba(0,200,255,0.15); border-radius:12px; color:var(--accent-primary); flex-shrink:0; }
  .service-title { font-size:1.1rem; font-family:var(--font-heading); font-weight:600; }
  .service-desc { font-size:0.9rem; color:var(--text-secondary); line-height:1.7; flex:1; }
  .service-link { font-size:0.85rem; color:var(--accent-primary); font-weight:500; }
  .about-inner { display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:center; }
  .about-highlights { display:flex; flex-direction:column; gap:1rem; }
  .highlight-card { display:flex; align-items:flex-start; gap:1rem; padding:1.25rem 1.5rem; }
  .highlight-icon { font-size:1.5rem; flex-shrink:0; margin-top:0.1rem; }
  .highlight-title { font-size:0.95rem; font-weight:600; margin-bottom:0.25rem; font-family:var(--font-heading); }
  .highlight-desc { font-size:0.875rem; color:var(--text-secondary); line-height:1.6; }
  .cta-section { text-align:center; position:relative; overflow:hidden; }
  .cta-glow { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:600px; height:300px; background:radial-gradient(ellipse,rgba(99,102,241,0.12) 0%,transparent 70%); pointer-events:none; }
  .cta-inner { position:relative; z-index:1; }
  .cta-actions { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; }
  @media (max-width:900px) {
    .hero-inner { grid-template-columns:1fr; text-align:center; }
    .hero-visual { order:-1; }
    .hero-actions, .available-badge { margin-left:auto; margin-right:auto; }
    .hero-actions { justify-content:center; }
    .hero-sub { margin-left:auto; margin-right:auto; }
    .about-inner { grid-template-columns:1fr; gap:2.5rem; }
    .stats-grid { grid-template-columns:repeat(2,1fr); }
    .services-grid { grid-template-columns:1fr; }
  }
</style>
